# Copy to .env. Never commit real secrets.
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_GATEWAY_API_KEY=
# To use your Vercel Gateway account instead:
# AI_PROVIDER=vercel
# GENERATION_MODEL=google/gemini-2.5-flash-lite
# EMBEDDING_MODEL=openai/text-embedding-3-small
# Set AI_GATEWAY_API_KEY privately; do not reuse a deployment's short-lived OIDC token.
GENERATION_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
DATA_DIR=./data
# local permits private documents for local use. public permits seeded documents only.
APP_MODE=local
ADMIN_TOKEN=
COOKIE_SECURE=false
PUBLIC_ORIGIN=
DAILY_PROVIDER_CALL_LIMIT=100
REQUESTS_PER_MINUTE=20
MAX_CONCURRENT_LIVE_REQUESTS=2
SESSION_RETENTION_HOURS=24
MAX_JSON_BYTES=16384
MAX_UPLOAD_BYTES=2000000
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
RETRIEVAL_CANDIDATES=10
CONTEXT_CHUNKS=5
RRF_K=60
# Optional USD / million tokens. Blank means cost unavailable, not zero.
GENERATION_INPUT_PRICE=
GENERATION_OUTPUT_PRICE=
EMBEDDING_INPUT_PRICE=
